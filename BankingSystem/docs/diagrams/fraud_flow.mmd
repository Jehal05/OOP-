flowchart LR
    T["Every deposit, withdrawal<br/>and outgoing transfer"] --> X["Build FraudContext<br/>last 10 min of activity,<br/>balance before, new payee flag,<br/>failed attempts"]
    X --> R1["LargeAmountRule<br/>over 50,000 or over 50% of balance"]
    X --> R2["RapidTransactionRule<br/>5 or more in 10 minutes"]
    X --> R3["NewBeneficiaryHighValueRule<br/>10,000 or more to a payee under 24h old"]
    X --> R4["OddHourRule<br/>debit between 01:00 and 04:00"]
    X --> R5["RepeatedFailureRule<br/>success after 3 or more failures"]
    R1 & R2 & R3 & R4 & R5 --> D{"Any rule fired?"}
    D -- no --> OK([Done])
    D -- yes --> A["Create Alert<br/>write to alerts.csv<br/>audit FRAUD_ALERT"]
    A --> U["Customer sees NEW alert<br/>on next dashboard"]
    A --> V["Admin reviews and<br/>marks it reviewed"]
    style A fill:#fff4e0,stroke:#d08a2e
    style OK fill:#d4edda,stroke:#3d9a50
