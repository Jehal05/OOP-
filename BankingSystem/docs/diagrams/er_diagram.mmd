erDiagram
    USERS ||--o| ACCOUNTS : "customer owns"
    ACCOUNTS ||--o{ TRANSACTIONS : has
    ACCOUNTS ||--o{ BENEFICIARIES : saves
    ACCOUNTS ||--o{ GOALS : sets
    ACCOUNTS ||--o{ LOANS : borrows
    TRANSACTIONS ||--o{ ALERTS : "may raise"
    USERS {
        string id PK
        string role
        string salt
        string hash
        int failed
        bool locked
        string accNo FK
    }
    ACCOUNTS {
        string accNo PK
        string type
        string holder
        double balance
        datetime openedOn
        bool active
        double param1
        double param2
    }
    TRANSACTIONS {
        string refId PK
        string accNo FK
        int type
        int category
        double amount
        double balanceAfter
        datetime timestamp
        string note
    }
    BENEFICIARIES {
        string owner FK
        string nickname
        string payeeAcc FK
        string payeeName
    }
    GOALS {
        string id PK
        string accNo FK
        string name
        double target
        double saved
        date deadline
    }
    LOANS {
        string id PK
        string type
        string accNo FK
        double principal
        int months
        int status
        int paid
    }
    ALERTS {
        string id PK
        string accNo FK
        string refId FK
        string rule
        string message
        bool reviewed
        bool seen
    }
