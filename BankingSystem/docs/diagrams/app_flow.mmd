flowchart TD
    A([Start]) --> B["Parse flags<br/>--data, --ascii, --no-color"]
    B --> C["Load CSV files"]
    C --> D{"First run?<br/>no users or accounts"}
    D -- yes --> E["Seed demo data"]
    D -- no --> F
    E --> F["Home menu"]
    F -->|1| G["Customer login"]
    F -->|2| H["Admin login"]
    F -->|3| X["Save all data"] --> Z([Exit])
    G --> I{"Valid and<br/>not locked?"}
    H --> I
    I -- no --> J["Show error and<br/>attempts remaining"] --> F
    I -- yes --> K{"Role"}
    K -- Customer --> L["Dashboard<br/>balance, recent activity,<br/>unread alerts"]
    K -- Admin --> M["Admin dashboard<br/>pending loans, alerts,<br/>locked users"]
    L --> N["Transactions, Smart statement,<br/>Spending, Goals, Loans,<br/>Beneficiaries, Simulator, Security"]
    M --> O["Accounts, History, Interest,<br/>Loan approvals, Fraud alerts,<br/>Reports, Security and audit log"]
    N --> P{"Logout or<br/>5 min idle?"}
    O --> P
    P -- no --> K
    P -- yes --> Q["Write LOGOUT or SESSION_TIMEOUT<br/>to audit log"] --> F
    style A fill:#d4edda,stroke:#3d9a50
